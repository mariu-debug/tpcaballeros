CREATE DATABASE caballeros_del_zodiaco

CREATE TABLE categorias (
    id_categoria INT AUTO_INCREMENT PRIMARY KEY,
    nombre_categoria VARCHAR(40)
);

CREATE TABLE personajes (
    id_personaje INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(40),
    fecha_nacimiento VARCHAR(50), 
    lugar_nacimiento VARCHAR(40),
    descripcion TEXT,
    genero VARCHAR(40),
    edad INT,
    peso DECIMAL(10,2),
    altura DECIMAL(10,2),
    maestro VARCHAR(40),
    constelacion VARCHAR(40),
    armadura VARCHAR(40),
    imagen VARCHAR(150) ,
    id_categoria INT ,
    FOREIGN KEY (id_categoria) REFERENCES categorias(id_categoria)
    );


